# Local dev only. Copy to .env and adjust. .env is gitignored.

WP_PORT=8080
WP_DEBUG=1

DB_NAME=andescon
DB_USER=andescon
DB_PASSWORD=andescon
DB_ROOT_PASSWORD=andescon-root

# WordPress admin user created by `bin/wp-install.sh`
WP_TITLE="IEEE ANDESCON"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
